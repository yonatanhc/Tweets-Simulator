import { useState } from 'react';
import {
  Button,
  Col,
  Collapse,
  ConfigProvider,
  DatePicker,
  Drawer,
  Form,
  Input,
  Row,
  Space,
  Tabs,
  Typography,
  theme,
} from 'antd';
import {
  ArrowLeftOutlined,
  CheckCircleFilled,
  CheckOutlined,
  UpOutlined,
} from '@ant-design/icons';
import dayjs from 'dayjs';

const { Text, Title } = Typography;
const { RangePicker } = DatePicker;

const DATE_FORMAT = 'YYYY-MM-DD';
const COMMENT_MAX_LENGTH = 40;
// TODO: confirmar rango permitido del valor (%) en el análisis funcional
const VALUE_REGEX = /^\d+(\.\d{1,2})?$/;

// TODO: confirmar nombres de campos (chargeId, rangeFrom, rangeTo, minLimit, maxLimit,
// limitBehaviour, currencyType) contra billing-openapi.yaml
const MOCK_CHARGE = {
  chargeId: 'CHG-0001',
  currencyType: 'ARS',
  rangeFrom: 0,
  rangeTo: 400250,
  minLimit: 1000,
  maxLimit: 400250,
  limitBehaviour: 'MIN_MAX', // TODO: confirmar enum de limitBehaviour
};

// TODO: confirmar textos de los labels (en la captura figuran como placeholders {range from}, etc.)
const LIMIT_ROWS = [
  { key: 'rangeFrom', label: 'Range from' },
  { key: 'rangeTo', label: 'Range to' },
  { key: 'minLimit', label: 'Min limit' },
  { key: 'maxLimit', label: 'Max limit' },
];

const formatAmount = (n) =>
  new Intl.NumberFormat('en-US', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(n);

/* ---------- Subcomponentes presentacionales ---------- */

const InfoRow = ({ label, children }) => (
  <Row justify="space-between" align="middle" style={{ padding: '8px 0' }}>
    <Col>
      <Text>{label}</Text>
    </Col>
    <Col>{children}</Col>
  </Row>
);

const TwoLineValue = ({ amount, currencyType }) => (
  <div style={{ textAlign: 'right', lineHeight: 1.3 }}>
    <Text>{formatAmount(amount)}</Text>
    <br />
    <Text type="secondary" style={{ fontSize: 12 }}>
      {currencyType}
    </Text>
  </div>
);

/* ---------- Pantalla ---------- */

const ChargeIdAccountEditDrawer = ({
  open = true,
  charge = MOCK_CHARGE, // TODO: reemplazar por datos de la API
  onClose,
  onBack,
  onSave,
}) => {
  const { token } = theme.useToken();
  const [form] = Form.useForm();
  const [activeTab, setActiveTab] = useState('newFeeVersion');
  const [saving, setSaving] = useState(false);

  const value = Form.useWatch('value', form);
  const valueIsValid = VALUE_REGEX.test(value ?? '');

  const handleClose = () => {
    form.resetFields();
    onClose?.();
  };

  const handleBack = () => {
    form.resetFields();
    (onBack ?? onClose)?.();
  };

  const handleSave = async () => {
    try {
      const values = await form.validateFields();
      const [effectiveFrom, effectiveTo] = values.effectiveDateRange;
      setSaving(true);
      // TODO: confirmar nombres del payload (effectiveFrom/effectiveTo/value/comment) en billing-openapi.yaml
      await onSave?.({
        chargeId: charge.chargeId,
        effectiveFrom: effectiveFrom.format(DATE_FORMAT),
        effectiveTo: effectiveTo.format(DATE_FORMAT),
        value: Number(values.value),
        currencyType: charge.currencyType,
        comment: values.comment.trim(),
      });
    } catch (e) {
      // los errores de validación ya se muestran en el Form
    } finally {
      setSaving(false);
    }
  };

  const limitsAndRanges = (
    <Collapse
      ghost
      defaultActiveKey={['limits']}
      expandIconPosition="end"
      expandIcon={({ isActive }) => <UpOutlined rotate={isActive ? 0 : 180} />}
      items={[
        {
          key: 'limits',
          label: <Text strong>Limits &amp; Ranges</Text>,
          children: (
            <>
              {LIMIT_ROWS.map(({ key, label }) => (
                <InfoRow key={key} label={label}>
                  <TwoLineValue amount={charge[key]} currencyType={charge.currencyType} />
                </InfoRow>
              ))}
              <InfoRow label="Limit behaviour">
                <Text>{charge.limitBehaviour}</Text>
              </InfoRow>
            </>
          ),
        },
      ]}
    />
  );

  const newFeeVersionForm = (
    <Form
      form={form}
      layout="horizontal"
      colon={false}
      labelCol={{ flex: '80px' }}
      wrapperCol={{ flex: 'auto' }}
      initialValues={{
        // TODO: confirmar valor por defecto del rango (en la captura aparece 2020-11-02 → 2020-11-02)
        effectiveDateRange: [dayjs('2020-11-02'), dayjs('2020-11-02')],
      }}
    >
      <Form.Item
        name="effectiveDateRange"
        label="Date"
        tooltip="Effective date range of the new fee version" // TODO: confirmar texto del tooltip
        rules={[{ required: true, message: 'Date is required' }]}
      >
        <RangePicker format={DATE_FORMAT} style={{ width: '100%' }} />
      </Form.Item>

      <Form.Item
        name="value"
        label="Value"
        tooltip="Fee value" // TODO: confirmar texto del tooltip
        rules={[
          { required: true, message: 'Value is required' },
          { pattern: VALUE_REGEX, message: 'Enter a valid number (max. 2 decimals)' },
        ]}
      >
        {/* TODO: confirmar si "%" es fijo o un selector % / monto fijo */}
        <Input
          addonBefore="%"
          addonAfter={charge.currencyType}
          placeholder="00.00"
          inputMode="decimal"
          suffix={
            valueIsValid ? (
              <CheckCircleFilled style={{ color: token.colorSuccess }} />
            ) : (
              <span />
            )
          }
        />
      </Form.Item>

      <Form.Item
        name="comment"
        label="Comment"
        labelCol={{ span: 24 }}
        wrapperCol={{ span: 24 }}
        rules={[
          { required: true, whitespace: true, message: 'Comment is required' },
          { max: COMMENT_MAX_LENGTH },
        ]}
      >
        {/* TODO: confirmar si "By the order of the Peaky Blinders" es placeholder o texto de ejemplo */}
        <Input.TextArea
          placeholder="By the order of the Peaky Blinders"
          maxLength={COMMENT_MAX_LENGTH}
          showCount
          autoSize={{ minRows: 3, maxRows: 5 }}
        />
      </Form.Item>
    </Form>
  );

  const tabItems = [
    {
      key: 'editRange',
      label: 'Edit Range',
      children: <div />, // TODO: contenido de la tab "Edit Range" (no incluido en la captura)
    },
    {
      key: 'newFeeVersion',
      label: 'Create New Fee Version',
      children: (
        <>
          {limitsAndRanges}
          <div style={{ marginTop: 24 }}>{newFeeVersionForm}</div>
        </>
      ),
    },
  ];

  return (
    <Drawer
      open={open}
      onClose={handleClose}
      width={560}
      title={
        <div>
          <Title level={5} style={{ margin: 0 }}>
            Charge ID Account Edit
          </Title>
          <Text type="secondary" style={{ fontWeight: 400, fontSize: 14 }}>
            Edit complete information about Account ID charges details.
          </Text>
        </div>
      }
      footer={
        <Space>
          {/* Amarillo acotado solo al botón Save. TODO: confirmar color de marca exacto */}
          <ConfigProvider
            theme={{
              components: {
                Button: {
                  colorPrimary: '#E0B71F',
                  colorPrimaryHover: '#EBC63A',
                  colorPrimaryActive: '#C79F12',
                  primaryColor: '#000000',
                },
              },
            }}
          >
            <Button type="primary" icon={<CheckOutlined />} loading={saving} onClick={handleSave}>
              Save
            </Button>
          </ConfigProvider>
          <Button icon={<ArrowLeftOutlined />} onClick={handleBack}>
            Back
          </Button>
        </Space>
      }
    >
      <Tabs activeKey={activeTab} onChange={setActiveTab} items={tabItems} />
    </Drawer>
  );
};

export default ChargeIdAccountEditDrawer;

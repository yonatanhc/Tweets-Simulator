import { useEffect, useMemo, useState } from 'react';
import {
  Alert, Breadcrumb, Button, Col, ConfigProvider, DatePicker, Divider, Form,
  Input, InputNumber, Row, Select, Space, Steps, Tag, Tooltip, Typography,
} from 'antd';
import { LockOutlined, QuestionCircleOutlined } from '@ant-design/icons';
import dayjs from 'dayjs';

const { Title, Text } = Typography;

// ---------------------------------------------------------------------------
// Config por variante (Tax {Debit} / Charge {Credit})
// TODO: confirmar nombres de campos y enums contra billing-openapi.yaml
// ---------------------------------------------------------------------------
const VARIANTS = {
  TAX_DEBIT: {
    breadcrumb: 'Tax {Debit}',
    title: 'New Tax Adjustment {Debit}',
    typeField: 'billingItemType',
    typeLabel: 'Billing Item Type',
    typePlaceholder: 'Select the Charge Type',
    showAccount: true,
    typeOptions: [
      { value: 'DEBT', label: 'Debt' },
      { value: 'TAX_IVA', label: 'Tax IVA' },
      { value: 'TAX_OTHERS', label: 'Tax Others' },
    ],
  },
  CHARGE_CREDIT: {
    breadcrumb: 'Charge {Credit}',
    title: 'New Charge Adjustment {Credit}',
    typeField: 'chargeType',
    typeLabel: 'Charge Type',
    typePlaceholder: 'Select the Charge Type',
    showAccount: false, // TODO: confirmar si el header Account también aplica a Charge
    typeOptions: [
      { value: 'ONLINE_CASH_CHARGE', label: 'Online cash charge' },
      // TODO: confirmar resto de charge types
    ],
  },
};

// Mock — facturas del período de balance actual (billingId)
// TODO: filtrar por billingState = TO_ANALYZE cuando haya API (regla de negocio de ajuste)
const MOCK_INVOICES = [
  { billingId: 'INV - 4821 - 7394', billingState: 'TO_ANALYZE' },
  { billingId: 'INV - 1953 - 8620', billingState: 'TO_ANALYZE' },
  { billingId: 'INV - 3745 - 2108', billingState: 'TO_ANALYZE' },
  { billingId: 'INV - 6298 - 4571', billingState: 'TO_ANALYZE' },
  { billingId: 'INV - 8036 - 1942', billingState: 'TO_ANALYZE' },
  { billingId: 'INV - 2570 - 6384', billingState: 'TO_ANALYZE' },
];

// TODO: confirmar si "Operating Jurisdiction" mapea a `office`
const MOCK_OFFICES = [
  { value: 'BA_GBA_PILAR', label: 'Buenos Aires GBA, Pilar' },
  { value: 'BA_CABA', label: 'Buenos Aires CABA' },
  { value: 'CORDOBA', label: 'Córdoba' },
];

const MOCK_ACCOUNT = { accountId: 'AK-MAMBU-89000122_ARS', accountName: 'Account Name' };
const CURRENCY = 'ARS'; // TODO: confirmar si viene de la cuenta
const COMMENT_MAX_LENGTH = 40; // TODO: confirmar si 40 es máximo o mínimo

// ---------------------------------------------------------------------------
// Subcomponentes presentacionales
// ---------------------------------------------------------------------------
const FormSection = ({ title, description, children }) => (
  <>
    <Row gutter={[24, 0]} style={{ padding: '24px 0' }}>
      <Col xs={24} md={8}>
        <Title level={5} style={{ marginTop: 0 }}>{title}</Title>
        <Text type="secondary">{description}</Text>
      </Col>
      <Col xs={24} md={16}>{children}</Col>
    </Row>
    <Divider style={{ margin: 0 }} />
  </>
);

const LabelWithHelp = ({ label, help }) => (
  <Space size={4}>
    {label}
    <Tooltip title={help}><QuestionCircleOutlined /></Tooltip>
  </Space>
);

// ---------------------------------------------------------------------------
// Pantalla
// ---------------------------------------------------------------------------
export default function ManualAdjustmentForm({
  variant = 'TAX_DEBIT',
  onBack, // TODO: confirmar navegación al paso 1 / listado
  onConfirm,
}) {
  const cfg = VARIANTS[variant];
  const [form] = Form.useForm();
  const [step, setStep] = useState(1); // 1 = Details, 2 = Review
  const [canApply, setCanApply] = useState(false);
  const values = Form.useWatch([], form);
  const isReview = step === 2;

  // Habilita "Apply" solo si el form es válido
  useEffect(() => {
    form
      .validateFields({ validateOnly: true })
      .then(() => setCanApply(true))
      .catch(() => setCanApply(false));
  }, [values, form]);

  const invoiceOptions = useMemo(
    () => MOCK_INVOICES.map(({ billingId }) => ({ value: billingId, label: billingId })),
    [],
  );

  const stepItems = [
    { title: 'Finished' },
    { title: isReview ? 'Finished' : 'Details' },
    { title: 'Review' },
  ];

  const handleBack = () => (isReview ? setStep(1) : onBack?.());

  const handleApply = async () => {
    await form.validateFields();
    setStep(2);
  };

  const handleConfirm = () => {
    // TODO: POST al endpoint de manual adjustments (payload alineado a billing-openapi.yaml)
    const payload = {
      ...form.getFieldsValue(true),
      billingDate: form.getFieldValue('billingDate')?.format('YYYY-MM-DD'),
      currency: CURRENCY,
    };
    onConfirm?.(payload);
  };

  return (
    <ConfigProvider
      theme={{
        components: {
          Button: { colorPrimary: '#F5C518', colorPrimaryHover: '#E0B20F', colorPrimaryActive: '#CCA10C', primaryColor: '#000' },
          Steps: { colorPrimary: '#000' },
        },
      }}
    >
      <div style={{ padding: 24 }}>
        <Breadcrumb
          items={[{ title: 'Manual Adjustments' }, { title: cfg.breadcrumb }]}
          style={{ marginBottom: 24 }}
        />

        <Steps
          current={isReview ? 2 : 1}
          items={stepItems}
          style={{ maxWidth: 1000, margin: '0 auto 24px' }}
        />

        <Alert
          type="warning"
          showIcon
          closable={!isReview}
          style={{ marginBottom: 24 }}
          message={isReview ? 'Please review the Adjustment summary prior to confirming.' : 'Creating a Manual Adjustment will:'}
          description={
            isReview
              ? 'Be aware that this action can not be undone.'
              : 'Credit or debit the amount back to the agent account. Create an audit trail entry. This action can not be undone.'
          }
        />

        {/* Header de la card */}
        <Row justify="space-between" align="middle" style={{ marginBottom: 16 }}>
          <Col><Title level={5} style={{ margin: 0 }}>{cfg.title}</Title></Col>
          <Col>
            <Space size="middle">
              {cfg.showAccount && !isReview && (
                <Space size={8}>
                  <LabelWithHelp label={<Text strong>Account</Text>} help="Account affected by this adjustment" />
                  <Tag style={{ borderRadius: 16, margin: 0 }}>
                    <Text type="secondary">{MOCK_ACCOUNT.accountId}</Text>{' '}
                    <Text>{MOCK_ACCOUNT.accountName}</Text>
                  </Tag>
                </Space>
              )}
              <Button onClick={handleBack}>Back</Button>
              {isReview ? (
                <Button type="primary" onClick={handleConfirm}>Confirm Adjustment</Button>
              ) : (
                <Button type="primary" disabled={!canApply} onClick={handleApply}>Apply</Button>
              )}
            </Space>
          </Col>
        </Row>
        <Divider style={{ margin: 0 }} />

        <Form
          form={form}
          layout="vertical"
          requiredMark
          disabled={isReview}
          initialValues={{ billingDate: dayjs(), invoiceReferences: [] }}
        >
          {/* Financial Details */}
          <FormSection
            title="Financial Details"
            description="Specify the exact amount and currency for this manual adjustment entry."
          >
            <Row gutter={24}>
              <Col xs={24} md={14}>
                <Form.Item
                  name={cfg.typeField}
                  label={cfg.typeLabel}
                  rules={[{ required: true, message: `Please select the ${cfg.typeLabel}` }]}
                >
                  <Select placeholder={cfg.typePlaceholder} options={cfg.typeOptions} />
                </Form.Item>
              </Col>
              <Col xs={24} md={10}>
                <Form.Item
                  name="amount"
                  label={<LabelWithHelp label="Amount" help="Amount must be greater than 0" />} // TODO: confirmar texto del tooltip
                  rules={[
                    { required: true, message: 'Please enter the amount' },
                    { type: 'number', min: 0.01, message: 'Amount must be greater than 0' },
                  ]}
                >
                  <InputNumber
                    style={{ width: '100%' }}
                    placeholder="00.00"
                    precision={2}
                    min={0}
                    addonAfter={CURRENCY}
                  />
                </Form.Item>
              </Col>
            </Row>
          </FormSection>

          {/* Reference Information */}
          <FormSection
            title="Reference Information"
            description="Link this adjustment to existing invoices and provide operational context."
          >
            <Row gutter={24}>
              <Col xs={24} md={14}>
                <Form.Item
                  name="invoiceReferences" // TODO: confirmar campo (lista de billingId)
                  label="Invoice Reference"
                  extra="Select Invoices from the current balance period."
                  rules={[{ required: true, type: 'array', min: 1, message: 'Select at least one invoice' }]}
                >
                  <Select
                    mode="multiple"
                    allowClear
                    placeholder="INV - XXXX - XXXX"
                    options={invoiceOptions}
                    maxTagCount={isReview ? undefined : 1}
                    maxTagPlaceholder={(omitted) => `and ${omitted.length} more Sel...`}
                  />
                </Form.Item>
                <Form.Item
                  name="office"
                  label="Operating Jurisdiction"
                  rules={[{ required: true, message: 'Select an Operating Jurisdiction' }]}
                >
                  <Select
                    placeholder="Select an Operating Jurisdiction"
                    options={MOCK_OFFICES}
                    suffixIcon={isReview ? <LockOutlined /> : undefined}
                  />
                </Form.Item>
              </Col>
              <Col xs={24} md={10}>
                <Form.Item
                  name="billingDate"
                  label={<LabelWithHelp label="Date" help="Adjustment effective date" />} // TODO: confirmar texto del tooltip
                  extra="Please select current or a future date."
                  rules={[{ required: true, message: 'Please select a date' }]}
                >
                  <DatePicker
                    style={{ width: '100%' }}
                    format="DD/MM/YYYY"
                    placeholder="Select date"
                    disabledDate={(d) => d && d.isBefore(dayjs(), 'day')}
                  />
                </Form.Item>
              </Col>
            </Row>
          </FormSection>

          {/* Justification */}
          <FormSection
            title="Justification"
            description="Provide a detailed description of why this manual adjustment is necessary for audit purposes."
          >
            <Form.Item
              name="comment"
              label="Comment"
              rules={[{ required: true, whitespace: true, message: 'Justification is required' }]}
            >
              <Input.TextArea
                rows={3}
                maxLength={COMMENT_MAX_LENGTH}
                showCount
                placeholder="Enter Justification Details"
              />
            </Form.Item>
          </FormSection>
        </Form>
      </div>
    </ConfigProvider>
  );
}

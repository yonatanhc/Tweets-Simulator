import { useState } from 'react';
import {
  Breadcrumb,
  Button,
  Card,
  Col,
  Empty,
  Form,
  Input,
  Radio,
  Row,
  Space,
  Steps,
  Typography,
  theme,
} from 'antd';
import { HomeOutlined } from '@ant-design/icons';

const { Text, Title } = Typography;

// TODO: confirmar enums contra billing-openapi.yaml
const ADJUSTMENT_CATEGORIES = [
  {
    value: 'GENERAL',
    title: 'General Adjustment',
    description: 'Standard adjustments to entity balances not tied to specific charges.',
  },
  {
    value: 'CHARGE',
    title: 'Charge Adjustment',
    description: 'Modifications to existing invoice lines or specific transactional charges.',
  },
  {
    value: 'TAX',
    title: 'Tax Adjustment',
    description: 'Corrections related to calculated tax amounts and statutory requirements.',
  },
];

const OPERATION_TYPES = [
  { value: 'DEBIT', label: 'Debit' },
  { value: 'CREDIT', label: 'Credit' },
  { value: 'NOT_BILLED_CREDIT', label: 'Not Billed Credit' },
];

const STEPS = [{ title: 'Setup' }, { title: 'Details' }, { title: 'Review' }];

const SelectableCard = ({ value, title, description, selected, onSelect }) => {
  const { token } = theme.useToken();
  return (
    <Card
      hoverable
      onClick={() => onSelect(value)}
      style={{
        height: '100%',
        borderColor: selected ? token.colorPrimary : undefined,
      }}
    >
      <Radio checked={selected} onChange={() => onSelect(value)}>
        <Title level={5} style={{ margin: 0 }}>
          {title}
        </Title>
      </Radio>
      <Text type="secondary" style={{ display: 'block', marginTop: 8, marginLeft: 24 }}>
        {description}
      </Text>
    </Card>
  );
};

const ManualAdjustments = () => {
  const [form] = Form.useForm();
  const [adjustmentCategory, setAdjustmentCategory] = useState('TAX'); // TODO: confirmar default (en la captura aparece Tax seleccionado)
  const [applied, setApplied] = useState(false);

  // TODO: confirmar nombre del campo en billing-openapi.yaml (accountId vs equivalente)
  const accountId = Form.useWatch('accountId', form);
  const hasCriteria = !!accountId?.trim(); // TODO: confirmar cuándo se habilita Apply (en la captura aparece deshabilitado)

  const handleReset = () => {
    form.resetFields();
    setAdjustmentCategory('TAX'); // TODO: confirmar si Reset también limpia la categoría
    setApplied(false);
  };

  const handleApply = () => {
    const { operationType, accountId } = form.getFieldsValue();
    // TODO: conectar API de búsqueda de forms con { adjustmentCategory, operationType, accountId }
    console.log({ adjustmentCategory, operationType, accountId });
    setApplied(true);
  };

  return (
    <Space direction="vertical" size="middle" style={{ width: '100%' }}>
      <Breadcrumb
        items={[{ title: <HomeOutlined /> }, { title: 'Manual Adjustments' }]}
      />

      <Card>
        <Steps current={0} items={STEPS} />
      </Card>

      <Card
        title="Adjustment Category"
        extra={
          <Space>
            <Button onClick={handleReset} disabled={!hasCriteria}>
              Reset
            </Button>
            <Button type="primary" onClick={handleApply} disabled={!hasCriteria}>
              Apply
            </Button>
          </Space>
        }
      >
        <Row gutter={[16, 16]}>
          {ADJUSTMENT_CATEGORIES.map((category) => (
            <Col xs={24} md={8} key={category.value}>
              <SelectableCard
                {...category}
                selected={adjustmentCategory === category.value}
                onSelect={setAdjustmentCategory}
              />
            </Col>
          ))}
        </Row>
      </Card>

      <Card title="Search or Filter">
        <Form form={form} layout="vertical" initialValues={{ operationType: 'CREDIT' }}>
          <Form.Item label="Operation Type" name="operationType">
            <Radio.Group options={OPERATION_TYPES} />
          </Form.Item>
          <Form.Item name="accountId" style={{ maxWidth: 400 }}>
            <Input placeholder="Search Account ID" allowClear />
          </Form.Item>
        </Form>
      </Card>

      <Card>
        {applied ? (
          // TODO: reemplazar por Table de Forms cuando exista el diseño/API
          <Empty description="No forms found" />
        ) : (
          <Empty
            image={null}
            description="Enter search criteria and click Apply to view Forms"
          />
        )}
      </Card>
    </Space>
  );
};

export default ManualAdjustments;
